{
  "name": "health-maxxing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/sync-content.ts --quiet",
    "dev": "next dev",
    "prebuild": "tsx scripts/sync-content.ts --quiet",
    "build": "next build",
    "prestart": "tsx scripts/sync-content.ts --quiet",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/validate-content.ts",
    "content:plan": "tsx scripts/plan.ts",
    "content:sync": "tsx scripts/sync-content.ts",
    "test": "npm run test:calc && npm run test:newsletter && npm run test:autopilot && npm run test:reset",
    "test:calc": "tsx scripts/test-calc.ts",
    "test:newsletter": "tsx scripts/test-newsletter.ts",
    "test:autopilot": "tsx scripts/test-autopilot.ts",
    "test:reset": "tsx scripts/test-password-reset.ts",
    "check": "npm run content:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
