# Copy to .env.local for development, or set these in your host's dashboard.
# Everything is optional for a first run: with nothing set, the site uses a
# SQLite file and creates an admin account with a random password, saved in
# data/admin-credentials.txt.

# Public address of the site, without a trailing slash.
# Used for links in emails, the sitemap, the RSS feed and share images.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admin account. On the next start it is created, or its password is reset.
# The password needs at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database. Leave empty for a SQLite file at ./data/health-maxxing.db.
# For a hosted libSQL / Turso database (needed on serverless hosts such as Vercel):
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# A long random string used to anonymise visitor IP addresses for rate limits.
# If empty, one is generated and stored in the database.
SESSION_SECRET=

# Autopilot: Claude researches and drafts articles from the topic queue.
ANTHROPIC_API_KEY=
# Scheduled autopilot runs call /api/cron/autopilot with this secret (16+ characters).
CRON_SECRET=

# Email over SMTP, for sending newsletter issues and password reset links.
# Works with any provider: Resend, Postmark, Amazon SES, Mailgun, Brevo…
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# EMAIL_FROM=Health Maxxing <hello@yourdomain.com>
SMTP_URL=
EMAIL_FROM=
